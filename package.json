{
  "packageManager": "pnpm@12.21.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
